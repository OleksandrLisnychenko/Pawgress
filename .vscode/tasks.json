{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run FastAPI (backend)",
      "type": "shell",
      "command": "${workspaceFolder}/backend/app/.venv/Scripts/python.exe",
      "args": ["-m", "uvicorn", "app.main:app", "--reload", "--port", "8000"],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run FastAPI (external terminal)",
      "type": "shell",
      "command": "cmd.exe",
      "args": [
        "/c",
        "start",
        "cmd",
        "/k",
        "${workspaceFolder}\\backend\\app\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --port 8000"
      ],
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "shell": {
          "executable": "C:\\Windows\\System32\\cmd.exe",
          "args": ["/c"]
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": false
      },
      "problemMatcher": []
    }
    ,
    {
      "label": "Run Frontend (Angular)",
      "type": "shell",
      "command": "npm",
      "args": ["start"],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    }
    ,
    {
      "label": "Run Frontend (external terminal)",
      "type": "shell",
      "command": "cmd.exe",
      "args": [
        "/c",
        "start",
        "cmd",
        "/k",
        "cd /d ${workspaceFolder}\\frontend && npm start"
      ],
      "options": {
        "cwd": "${workspaceFolder}/frontend",
        "shell": {
          "executable": "C:\\Windows\\System32\\cmd.exe",
          "args": ["/c"]
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": false
      },
      "problemMatcher": []
    }
  ]
}
